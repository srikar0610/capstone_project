# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.
# The default path does not call a model provider, so the unattended
# run does not depend on a free-tier quota. Set USE_LLM=true only after
# OPENROUTER_API_KEY is a real key.

OPENROUTER_API_KEY=your_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_LLM=false

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.40
RETRIEVAL_TOP_K=3
RELEVANCE_THRESHOLD=0.08
KILL_SWITCH=false
PROMETHEUS_PORT=8000
